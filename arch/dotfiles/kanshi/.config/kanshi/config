profile home {
  output eDP-1 disable
  output "Acer Technologies V276HL T4JAA0028567" enable mode 1920x1080@60.000Hz position 0,0
  output "Unknown Unknown Unknown" enable mode 1920x1080@60.000Hz position 1920,0
  exec niri msg action move-workspace-to-monitor-right
}

profile unplugged {
	output eDP-1 position 0,0 enable mode 2880x1620@120.002Hz 
}

